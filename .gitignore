# Release signing material. The signing keys for the mobile stores belong to the
# maintainer and never enter this repository; these patterns are the second line
# of defence behind that rule, repo-wide rather than per-platform, because a key
# gets dropped wherever the terminal happened to be.
*.jks
*.keystore
*.p12

# per-tenant deploy settings (see deploy/.env.example)
deploy/.env
deploy/podman/.env
deploy/podman/.env.*
!deploy/podman/.env.example
/.env
# pnpm content store must live on a Linux volume (see repo-start.sh);
# never commit it if one lands in the checkout.
/.pnpm-store/
# ty-desktop local-deploy binaries (see deploy/local/TY-DESKTOP.md):
# place beside this file on the build host, never commit.
/deploy/local/muse-linux/
/deploy/local/gateway/bin/wacli
/deploy/local/gateway/signal-bin/
